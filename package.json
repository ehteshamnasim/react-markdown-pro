{
  "name": "react-markdown-pro",
  "version": "2.0.0",
  "type": "module",
  "author": {
    "name": "Ehtesham",
    "email": "ehteshamnasim@gmhotmail.com"
  },
  "description": "A customizable React Markdown renderer with GFM, KaTeX, code highlighting, and safe HTML controls.",
  "license": "MIT",
  "homepage": "https://ehteshamnasim.github.io/react-markdown-pro/demo.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehteshamnasim/react-markdown-pro.git"
  },
  "bugs": {
    "url": "https://github.com/ehteshamnasim/react-markdown-pro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./style.css": "./lib/style.css"
  },
  "types": "lib/index.d.ts",
  "sideEffects": [
    "./lib/style.css"
  ],
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && vite build --config vite.lib.config.ts && node scripts/postbuild-cjs.mjs && tsc --emitDeclarationOnly",
    "start": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run test:package && npm run test:e2e && node scripts/package-dry-run.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "keywords": [
    "react-markdown-pro",
    "react markdown",
    "markdown renderer",
    "react component",
    "github flavored markdown",
    "gfm",
    "katex",
    "latex",
    "math",
    "syntax highlighting",
    "code blocks",
    "typescript",
    "safe html"
  ],
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.18.6",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^17.0.0",
    "@types/react-copy-to-clipboard": "^5.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "katex": "^0.16.47",
    "react": "^17.0.2",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^17.0.2",
    "react-markdown": "^8.0.7",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^6.0.3",
    "rehype-raw": "^6.1.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^5.1.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.9.5",
    "unified": "^10.1.2",
    "vite": "^4.0.0",
    "vitest": "^3.2.7"
  }
}
