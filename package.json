{
  "name": "react-markdown-pro",
  "version": "1.0.9",
  "author": {
    "name": "Ehtesham",
    "email": "ehteshamnasim@gmhotmail.com"
  },
  "description": "An enhanced React markdown component with image, code, and LaTeX support.",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "start": "vite",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "keywords": [
    "react-markdown-pro",
    "markdown",
    "react",
    "katex",
    "syntax highlighting",
    "code blocks",
    "image rendering",
    "LaTeX",
    "markdown",
    "renderer"
  ],
  "dependencies": {
    "katex": "^0.16.8",
    "react-copy-to-clipboard": "^5.1.0",
    "react-markdown": "^8.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "rehype-katex": "^6.0.0",
    "rehype-raw": "^6.1.1",
    "rehype-slug": "^5.1.0",
    "remark-gfm": "^3.0.0",
    "remark-math": "^5.0.0",
    "unified": "^10.1.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.18.6",
    "@types/react": "^17.0.0",
    "@types/react-copy-to-clipboard": "^5.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "rimraf": "^3.0.2",
    "typescript": "^4.9.5",
    "vite": "^4.0.0"
  }
}
